from ctypes import *
from ctypes.util import find_library
from enum import IntEnum
import os
import sys
import sysconfig
import platform

def _find_bundled_isl():
    lib_dir = os.path.join(sysconfig.get_path('data'), 'lib')
    lib_dir = os.path.abspath(lib_dir)
    library_name = {
        "Linux": "libisl.so",
        "Darwin": "libisl.dylib",
        "Windows": "libisl.dll",
    }.get(platform.system())
    if library_name is None:
        return None

    library_path = os.path.join(lib_dir, library_name)
    return library_path if os.path.isfile(library_path) else None

isl_library_path = _find_bundled_isl() or find_library("isl")
isl = cdll.LoadLibrary(isl_library_path)
assert isl is not None, "can't find the isl shared library!"
libc = cdll.LoadLibrary(find_library("c"))
libc.fdopen.argtypes = [c_int, c_char_p]
libc.fdopen.restype = c_void_p
libc.fclose.argtypes = [c_void_p]
libc.fclose.restype = c_int

class format(IntEnum):
  ISL = 0
  POLYLIB = 1
  POLYLIB_CONSTRAINTS = 2
  OMEGA = 3
  C = 4
  LATEX = 5
  EXT_POLYLIB = 6

class yaml_style(IntEnum):
  BLOCK = 0
  FLOW = 1

class dim_type(IntEnum):
	CST = 0
	PARAM = 1
	IN = 2
	OUT = 3
	SET = 3
	DIV = 4
	ALL = 5

class ast_expr_type(IntEnum):
  ERROR = -1
  OP = 0
  ID = 1
  INT = 2

class ast_expr_op_type(IntEnum):
  ERROR = -1
  AND = 0
  AND_THEN = 1
  OR = 2
  OR_ELSE = 3
  MAX = 4
  MIN = 5
  MINUS = 6
  ADD = 7
  SUB = 8
  MUL = 9
  DIV = 10
  FDIV_Q = 11
  PDIV_Q = 12
  PDIV_R = 13
  ZDIV_R = 14
  COND = 15
  SELECT = 16
  EQ = 17
  LE = 18
  LT = 19
  GE = 20
  GT = 21
  CALL = 22
  ACCESS = 23
  MEMBER = 24
  ADDRESS_OF = 25

class Error(Exception):
    pass

class Context:
    defaultInstance = None

    def __init__(self):
        ptr = isl.isl_ctx_alloc()
        self.ptr = ptr

    def __del__(self):
        # During interpreter shutdown the order in which module globals are
        # cleared is unspecified, so isl objects may well outlive the context
        # they refer to.  Freeing it then only produces
        # "isl_ctx not freed as some objects still reference it" on stderr;
        # the process is about to hand the memory back anyway.
        if sys.is_finalizing():
            return
        isl.isl_ctx_free(self)

    def from_param(self):
        return c_void_p(self.ptr)

    @staticmethod
    def getDefaultInstance():
        if Context.defaultInstance == None:
            Context.defaultInstance = Context()
        return Context.defaultInstance

    # Attaching a Python object to an isl_id hands isl a raw PyObject * and
    # keeps it alive by hand.  ctypes only lets that work on CPython, so
    # id(name, user) and id.user() are not available under PyPy.
    @CFUNCTYPE(None, py_object)
    def free_user(user):
        pythonapi.Py_DecRef(py_object(user))

isl.isl_ctx_alloc.restype = c_void_p
isl.isl_ctx_free.argtypes = [Context]
isl.isl_id_alloc.restype = c_void_p
isl.isl_id_alloc.argtypes = [Context, c_char_p, py_object]
isl.isl_id_set_free_user.restype = c_void_p
isl.isl_id_set_free_user.argtypes = [c_void_p, c_void_p]
isl.isl_id_get_free_user.restype = c_void_p
isl.isl_id_get_free_user.argtypes = [c_void_p]
# isl_id_get_user returns a borrowed reference; declaring it as py_object
# would make ctypes drop a reference that it never acquired.
isl.isl_id_get_user.restype = c_void_p
isl.isl_id_get_user.argtypes = [c_void_p]

isl.isl_ctx_last_error.restype = c_int
isl.isl_ctx_last_error.argtypes = [Context]
isl.isl_ctx_last_error_msg.restype = c_char_p
isl.isl_ctx_last_error_msg.argtypes = [Context]
isl.isl_ctx_last_error_file.restype = c_char_p
isl.isl_ctx_last_error_file.argtypes = [Context]
isl.isl_ctx_last_error_line.restype = c_int
isl.isl_ctx_last_error_line.argtypes = [Context]
isl.isl_ctx_reset_error.argtypes = [Context]

def _error(ctx, call, what=""):
    """Build an Error for a failed call to the C function named "call".

    isl reports what went wrong through the context (and, with the default
    on_error setting, on stderr); without this the exception would carry
    nothing at all.

    Whatever message is found here was left by "call" itself, because
    the context is kept clean: every message this binding reports is reset
    on the way out, and the calls whose result cannot express a failure
    clear the context on their own (see _discard_error).  A call that
    returns NULL without recording anything, as isl_ast_node_get_annotation
    does for a node that simply has no annotation, therefore finds
    the context empty and says only that much.
    """
    msg = isl.isl_ctx_last_error_msg(ctx)
    if msg is None:
        return Error("%s%s" % (call, what))
    where = isl.isl_ctx_last_error_file(ctx)
    line = isl.isl_ctx_last_error_line(ctx)
    isl.isl_ctx_reset_error(ctx)
    msg = msg.decode('ascii')
    if where is None:
        return Error("%s%s: %s" % (call, what, msg))
    return Error("%s%s: %s (%s:%d)" %
                 (call, what, msg, where.decode('ascii'), line))

def _discard_error(ctx):
    """Drop any error recorded by a call that cannot report one.

    A handful of isl functions return a plain number, so a failure leaves
    nothing in the result to act on.  The message isl recorded would then
    stay behind and be picked up by the next call that does look, which is
    how it would end up explaining something it has nothing to do with.
    """
    if isl.isl_ctx_last_error(ctx) != 0:
        isl.isl_ctx_reset_error(ctx)

